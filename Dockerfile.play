# The island for the browser, on a shelf (Plans/spelen-in-de-browser.md).
#
# Not the sea and not an islander: a static page that joins the open sea from the visitor's own
# browser, exactly like the app on a phone. scripts/pack-web.mjs lays it out as play/<id>/ with
# play/version.json and a door, and nginx serves it with the files compressed ahead of time.
#
#   docker build -f Dockerfile.play -t promptholm-play .
#   docker run -p 4760:80 -v play-shelf:/usr/share/nginx/html/play promptholm-play
#
# ---- the pack -----------------------------------------------------------------
# three.js is the one dependency, and only it is installed: `npm ci` would pull the Tauri CLI
# (a native binary per platform) to vendor a handful of files. Into a folder of its own and
# linked, since `npm install <pkg>` inside the checkout reifies the whole package.json anyway.
# The whole checkout is copied for the same reason as the sea's stamp: package.json and .git say
# which build this is (lib/buildinfo.mjs, read by hand - no git binary needed).
FROM node:22-alpine AS pack
WORKDIR /src
COPY . .
ARG PLAY_SEA=https://agentvillage.xeroxmsj.freeddns.org/
RUN three=$(node -p "require('./package.json').devDependencies.three") \
 && npm install --prefix /deps --no-audit --no-fund --ignore-scripts "three@$three" \
 && rm -rf node_modules && ln -s /deps/node_modules node_modules \
 && node scripts/vendor.mjs \
 && node scripts/pack-web.mjs --sea "$PLAY_SEA" --out /out

# ---- the shelf -----------------------------------------------------------------
FROM nginx:alpine
COPY deploy/play/nginx.conf /etc/nginx/conf.d/default.conf
# Run by the image's own entrypoint before nginx starts: puts this build's shelf beside the ones
# already in the volume, then moves the door. See the script.
COPY deploy/play/shelf.sh /docker-entrypoint.d/40-promptholm-shelf.sh
RUN chmod +x /docker-entrypoint.d/40-promptholm-shelf.sh
COPY --from=pack /out /opt/play
