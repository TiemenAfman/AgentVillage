node_modules/
web/vendor/
data/*
!data/.gitkeep

# Blender's own backup copy, and the preview renders: both are made from a .blend that
# is committed, so anyone can make them again and nobody has to download them.
assets/**/renders/
*.blend1

# per-machine settings; config.example.json is the template
config.json
config.json.bak*

# never publish credentials or local traces
.env
.env.*
*.log
*.log.1

# the mail accounts behind the town hall postbox: servers, usernames and passwords. The
# data/ rule above already covers it - this second one is deliberate, so that widening
# that rule later cannot quietly start publishing somebody's mail password.
data/mail.json
# the token that holds this island's claim in the sea - whoever has it can publish over it
data/sea-token.json

# somebody else's island, parked here while they visit. Swept at every start anyway, so a
# copy in the history would outlive the visit itself.
data/guests/
# Written by the keeper's own page: where the renderer actually put each building.
# Generated, safe to delete, rebuilt the next time anybody looks at the island.
data/placements.json
/.vs/

# A release laid out by scripts/pack-release.mjs
/dist/
