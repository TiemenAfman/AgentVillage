node_modules/
web/vendor/
data/*
!data/.gitkeep

# Blender's own backup copy, and the preview renders: both are made from a .blend that
# is committed, so anyone can make them again and nobody has to download them.
assets/**/renders/
*.blend1

# the keeper's own music for the rooms (lib/music.mjs): HOME/audio, which in a linked worktree is
# the checkout itself - somebody's mp3s are theirs, never the repository's
/audio/
# the HD pack (Plans/hd-pakket.md): HOME/hd, textured models that live in a repository of their own so
# this one and its installers stay small; in a linked worktree HOME is the checkout itself
/hd/

# per-machine settings; config.example.json is the template
config.json
config.json.bak*

# never publish credentials or local traces
.env
.env.*
*.log
*.log.1

# the mail accounts behind the town hall postbox: servers, usernames and passwords. The
# data/ rule above already covers it - this second one is deliberate, so that widening
# that rule later cannot quietly start publishing somebody's mail password.
data/mail.json
# the token that holds this island's claim in the sea - whoever has it can publish over it
data/sea-token.json

# somebody else's island, parked here while they visit. Swept at every start anyway, so a
# copy in the history would outlive the visit itself.
data/guests/
# Written by the keeper's own page: where the renderer actually put each building.
# Generated, safe to delete, rebuilt the next time anybody looks at the island.
data/placements.json
/.vs/

# A release laid out by scripts/pack-release.mjs
/dist/
# Scratch measurements a session leaves in tests/ while it works; never part of the suite.
tests/.tmp-*

# Python bytecode from the Blender build scripts that import each other (scripts/krakenkit/).
__pycache__/

# Mixamo's raw clips: Adobe allows them in a game, not handed out as files, and this repo is
# public. What the game plays is baked into web/js/gait-clips.js; the FBX stay on the keeper's
# machine (assets/mixamo/clips.json says which, the mixamo-clips skill how to get them again).
assets/mixamo/*.fbx
