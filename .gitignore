node_modules/
web/vendor/
data/*
!data/.gitkeep
# Pages for the billboards, which are content rather than state: somebody wrote them to
# be read, so they travel with the island instead of staying on one machine. See
# lib/billboard.mjs.
!data/boards/
data/boards/*
!data/boards/*.html
!data/boards/*.css
!data/boards/*.js
!data/boards/*.svg
!data/boards/*.png
!data/boards/*.jpg

# per-machine settings; config.example.json is the template
config.json

# never publish credentials or local traces
.env
.env.*
*.log
*.log.1

# Gegenereerde codedump voor externe AI (ai_studio_code.ps1); regenereerbaar, hoort niet in git.
codebase.txt

# Windows-builds van scripts/build.ps1: ~250 MB per release.
dist/

# Schermafdrukken van de Godot-harness, opnieuw te maken met scripts/shots.ps1.
godot/.captures/

# De screenshot-matrix zelf is ~94 MB aan PNG's en komt terug uit scripts/shots.ps1. Het
# contactvel per label blijft wel in git: 12 kB, en het legt vast wat er wanneer geschoten is,
# ook als de beelden er niet bij zitten.
docs/shots/**/*.png
docs/shots/**/*.jpg

# Texturen van ambientCG: opgehaald met scripts/textures.mjs, niet in git.
# Zestig megabyte binaries die git voor altijd bewaart, terwijl ze met een
# commando terugkomen. Het manifest (assets/textures.json) staat er wel in.
godot/assets/ambientcg/
godot/assets/terrain-packed/
